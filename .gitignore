# Node modules
node_modules/

# Logs
*.log

# OS files
.DS_Store
Thumbs.db

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Build files
dist/
build/

# Temporary files
*.tmp
*.temp

# Release packages
*.zip

# Backups
bkp/

# Documentation files (opted out except the ones versioned on purpose:
# CLAUDE.md, and privacy.md in each build - it ships inside the release zip)
*.md
!CLAUDE.md
!inss-notas-extensao-firefox/privacy.md
# Design-system records read by tooling - same class as CLAUDE.md, not prose
!PRODUCT.md
!DESIGN.md
!/.impeccable/critique/*.md

# Impeccable design tooling - version the records, not the runtime state
.impeccable/hook.cache.json
.impeccable/live/
.impeccable/*.png
